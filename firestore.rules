rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.auth != null && request.auth.uid == playerId);
      allow update: if isAdmin()
        || (request.auth != null
          && (request.auth.uid == playerId || resource.data.authUid == request.auth.uid));
    }

    // Tournaments and matches: protect isVerified updates
    match /tournaments/{tournamentId}/matches/{matchId} {
      allow read: if true;

      // Allow creating/updating match results by authenticated users (submitters or admins)
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Allow setting isVerified to true only by opponent or admin
        (request.resource.data.keys().hasOnly(['isVerified'])
          && request.resource.data.isVerified == true
          && (
            request.auth.uid == resource.data.winnerPlayerId ||
            request.auth.uid == resource.data.loserPlayerId ||
            isAdmin()
          )
        )
        // Submitters may correct their own result while it is unverified.
        || (resource.data.submittedBy == request.auth.uid
          && resource.data.isVerified == false
          && request.resource.data.isVerified == false
          && request.resource.data.submittedBy == request.auth.uid)
        || isAdmin()
      );
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow update: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // user may update their own registration but cannot change registrationStatus
        (request.auth.uid == resource.data.authUid || request.auth.uid == request.resource.id) &&
        request.resource.data.registrationStatus == resource.data.registrationStatus
      ) || isAdmin();
    }
  }
}
